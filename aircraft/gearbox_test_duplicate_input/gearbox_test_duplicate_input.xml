<?xml version="1.0"?>
<fdm_config name="gearbox-test-duplicate-input" release="ALPHA" version="2.0">

  <fileheader>
    <author> jsbsim-programmer </author>
    <description>
      Malformed variant of aircraft/gearbox_test/gearbox_test.xml, used only
      to verify the REQ-003 review MAJOR #2 fix: a second &lt;input
      engine="0"&gt; within the SAME &lt;gearbox&gt; element must be
      rejected at load time with a clear, actionable error. Deliberately
      never loads successfully -- not part of the regular test-regression
      suite (see scripts/test_gearbox_steadystate.xml for the aircraft this
      is a broken copy of).
    </description>
  </fileheader>

