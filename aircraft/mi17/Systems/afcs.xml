<system name="afcs">

  <!-- Mi-17 Automatic Flight Control System (AFCS) -->
  <!-- 
       The Mi-17 has a basic AFCS with:
       - Attitude hold
       - Heading hold
       - Altitude hold
       - Speed hold
       - Stability augmentation
  -->

  <!-- AFCS properties -->
  <property value="0.0"> ap/attitude-hold-on </property>
  <property value="0.0"> ap/heading-hold-on </property>
  <property value="0.0"> ap/altitude-hold-on </property>
  <property value="0.0"> ap/speed-hold-on </property>
  <property value="1.0"> ap/stability-aug-on </property>

  <!-- AFCS gains -->
  <property value="0.5"> ap/pitch-gain </property>
  <property value="0.5"> ap/roll-gain </property>
  <property value="0.3"> ap/yaw-gain </property>
  <property value="0.4"> ap/collective-gain </property>
  <!-- Declared at system scope, not inside the "altitude hold"
       channel below where it's used: a <property> element nested
       inside a <channel> is not registered in time for a same-
       channel <pid>'s <ki> to resolve it by name at parse time (no
       other <property> in this aircraft's Systems/*.xml is nested
       inside a <channel> either; confirmed the hard way: FGFCS threw
       "Property ap/altitude-integral-gain does not exist" when it was
       declared inline just above the <pid> that uses it). See the
       altitude hold channel's integral-term comment for what this
       gain actually does. ap/altitude-gain and ap/altitude-rate-gain
       (the P and rate terms' own gains) are declared here for the
       same reason, promoted from bare <value> literals so a script
       can override them for bracket-testing without editing this
       file each time.

       Both raised 50x from their original values (0.0001 -> 0.005,
       0.001 -> 0.05 in magnitude) as part of a broader fix: the old
       climb-out (an open-loop collective ramp to 0.75, handed off to
       altitude hold only after the fact) had no altitude awareness at
       all and produced huge overshoot (climbing to 1000+ ft against a
       100 ft target) before this slow, weak correction could claw it
       back down over many minutes. Replacing that with a genuinely
       closed-loop climb; engage altitude-hold at liftoff, holding
       collective at the real trim value (~0.092, back-computed from a
       validated near-zero-v-down state) and letting ap/collective-cmd
       do 100% of the climbing; fixes the structural cause, but the
       original P/rate gains were tuned for correcting a small residual
       error near an already-good baseline, not driving a climb from
       ~100 ft of error; at 1x they still converge cleanly, just slowly
       (84 ft by 450s post-engage). Bracket-tested 1x up to 320x
       (0.032/-3.2): stayed clean and monotonic at every step tried
       (99+ ft within ~450s even at 1x, ~99 ft within ~80s at 50x, with
       no oscillation observed even at the top of the bracket; the
       plant's own response lag becomes the limiting factor well before
       the loop itself would show instability). Settled on 50x for
       comfortable margin under everything actually tested, not the
       fastest value tried. -->
  <property value="0.0000002"> ap/altitude-integral-gain </property>
  <property value="0.005"> ap/altitude-gain </property>
  <!-- Negative, not positive: ap/vertical-speed-error-fps (below) is
       defined as target(always 0) - v_down, so it comes out POSITIVE
       while climbing (v_down < 0) and NEGATIVE while descending. A
       positive gain on that sign convention adds collective while
       already climbing and removes it while already descending;
       positive feedback on the rate channel, not damping. Found the
       hard way while bracket-testing the closed-loop climb-out
       redesign: raising this gain (still positive at the time) made
       overshoot dramatically WORSE (733 ft peak instead of settling
       cleanly), the opposite of what a damping term should do.
       Flipping the sign makes rate_term negative while climbing and
       positive while descending, correctly opposing whatever vertical
       rate already exists. -->
  <property value="-0.05"> ap/altitude-rate-gain </property>

  <!-- AFCS targets: never declared in the original model, only ever read
       by the hold-mode error fcs_functions below. All hold modes default
       off (see ap/*-hold-on above), so 0.0 is an inert placeholder until
       something (pilot input, a future "engage autopilot at current
       attitude" latch) actually sets these. -->
  <property value="0.0"> ap/pitch-target-rad </property>
  <property value="0.0"> ap/roll-target-rad </property>
  <property value="0.0"> ap/heading-target-rad </property>
  <property value="0.0"> ap/altitude-target-ft </property>
  <property value="0.0"> ap/speed-target-fps </property>
  <property value="0.0"> ap/vertical-speed-target-fps </property>

  <!-- Attitude hold -->
  <channel name="attitude hold">
    <fcs_function name="ap/pitch-error-rad">
      <function>
        <difference>
          <property> ap/pitch-target-rad </property>
          <property> attitude/pitch-rad </property>
        </difference>
      </function>
    </fcs_function>

    <fcs_function name="ap/roll-error-rad">
      <function>
        <difference>
          <property> ap/roll-target-rad </property>
          <property> attitude/roll-rad </property>
        </difference>
      </function>
    </fcs_function>

    <fcs_function name="ap/elevator-cmd">
      <function>
        <product>
          <property> ap/pitch-error-rad </property>
          <property> ap/pitch-gain </property>
          <property> ap/attitude-hold-on </property>
        </product>
      </function>
    </fcs_function>

    <fcs_function name="ap/aileron-cmd">
      <function>
        <product>
          <property> ap/roll-error-rad </property>
          <property> ap/roll-gain </property>
          <property> ap/attitude-hold-on </property>
        </product>
      </function>
    </fcs_function>
  </channel>

  <!-- Heading hold -->
  <channel name="heading hold">
    <fcs_function name="ap/heading-error-rad">
      <function>
        <difference>
          <property> ap/heading-target-rad </property>
          <property> attitude/heading-true-rad </property>
        </difference>
      </function>
    </fcs_function>

    <fcs_function name="ap/rudder-cmd">
      <function>
        <product>
          <property> ap/heading-error-rad </property>
          <property> ap/yaw-gain </property>
          <property> ap/heading-hold-on </property>
        </product>
      </function>
    </fcs_function>
  </channel>

  <!-- Altitude hold -->
  <channel name="altitude hold">
    <fcs_function name="ap/altitude-error-ft">
      <function>
        <difference>
          <property> ap/altitude-target-ft </property>
          <property> position/h-sl-ft </property>
        </difference>
      </function>
    </fcs_function>

    <fcs_function name="ap/vertical-speed-error-fps">
      <function>
        <difference>
          <property> ap/vertical-speed-target-fps </property>
          <property> velocities/v-down-fps </property>
        </difference>
      </function>
    </fcs_function>

    <!-- Gains reduced 5x (0.001->0.0002, 0.01->0.002): thrust is very
         sensitive to collective near this model's hover trim point
         (~6000 lbs of thrust change across collective 0.4-0.7, per
         scripts/_diag_hover_trim.xml), and the underlying propulsion/
         governor dynamics settle over tens of seconds (scripts/_diag_
         gov_settle.xml), much slower than this loop reacts every
         frame. At the original gains this produced a large, slowly-
         growing altitude/pitch oscillation once actually exercised in
         scripts/test_mi17_hover.xml (h-agl-ft swinging 6 -> 22 -> 0.6
         ft, pitch spiking to 35+ deg, v-down-fps swinging +-35) instead
         of a damped approach to the target, a classic outer-loop-
         faster-than-inner-loop instability.

         Halved again (0.0002->0.0001, 0.002->0.001) alongside the
         mi17.xml mass/CG/inertia correction and the test_mi17_hover.
         xml handoff-timing fix (altitude hold used to engage ~45s
         late, after a ~1167 ft error had already built up; it now
         engages within seconds of actual liftoff, so the loop starts
         from a small error instead of a huge one). This second
         reduction is a conservative, not-yet-validated step in the
         same direction as the first, made for the same underlying
         reason: the plant (governor + rotor inflow) still settles far
         slower than this per-frame loop reacts, and that mismatch is
         a function of the airframe's response lag, not of how large
         the initial error happens to be, so some further margin still
         seemed prudent even with the handoff fix removing most of the
         error spike. Retune based on the next hover run's actual
         result, not just this reasoning. -->

    <!-- Integral term: the two products above are proportional-only
         (position + rate), which can damp oscillation but can never
         drive a standing error to zero; confirmed by an actual run
         (scripts/test_mi17_hover.xml, this branch's history): with
         the handoff-timing and collective-ramp-race bugs both fixed,
         the aircraft climbs, stops porpoising, and holds level, but
         stabilizes ~930-940 ft AGL against a ~30 ft AGL target and
         just sits there; a stable but permanent offset, because the
         base collective trim (0.68, unvalidated) is somewhat above
         true hover-equilibrium thrust and nothing here ever integrates
         that standing error away.

         Anti-windup follows rpm_governor.xml's own <pid> pattern
         (governor/pid-saturated -> <trigger>): freeze/reset via a
         <switch>-driven trigger rather than letting the integrator
         accumulate for the entire ~140s+ ground/climb-out phase
         before altitude hold ever engages, or run away once its own
         output saturates. -0.15/0.15 rad clip on the integral term
         alone (not the full collective range) keeps its authority
         bounded relative to the base 0.68 trim and the P/rate terms
         above.

         ki=0.0000002 is a rough, unvalidated starting point, not a
         tuned value: at the observed ~900 ft standing error, it
         contributes roughly 0.0000002*900 = 0.00018/sec, i.e. on the
         order of 0.02-0.03 rad after a couple of minutes; deliberately
         slow, on the same reasoning as afcs.xml's other gains above
         (the plant settles over tens of seconds; a fast-reacting
         integral risks the same outer-loop-faster-than-inner-loop
         oscillation already seen once with the proportional gains).
         Needs validation against an actual hover run, not just this
         estimate. ap/altitude-integral-gain itself is declared up in
         the AFCS gains block near the top of this file, not here;
         see that declaration's comment for why. -->
    <switch name="ap/altitude-integral-trigger">
      <default value="0.0"/>
      <test value="-1.0">
        ap/altitude-hold-on lt 0.5
      </test>
      <test value="1.0">
        ap/altitude-integral-cmd ge 0.15
      </test>
      <test value="1.0">
        ap/altitude-integral-cmd le -0.15
      </test>
    </switch>

    <pid name="ap/altitude-integral-cmd">
      <input> ap/altitude-error-ft </input>
      <ki> ap/altitude-integral-gain </ki>
      <trigger> ap/altitude-integral-trigger </trigger>
      <clipto>
        <min> -0.15 </min>
        <max>  0.15 </max>
      </clipto>
    </pid>

    <fcs_function name="ap/collective-cmd">
      <function>
        <sum>
          <product>
            <property> ap/altitude-error-ft </property>
            <property> ap/altitude-gain </property>
            <property> ap/altitude-hold-on </property>
          </product>
          <product>
            <property> ap/vertical-speed-error-fps </property>
            <property> ap/altitude-rate-gain </property>
            <property> ap/altitude-hold-on </property>
          </product>
          <product>
            <property> ap/altitude-integral-cmd </property>
            <property> ap/altitude-hold-on </property>
          </product>
        </sum>
      </function>
      <!-- Bounds the P+rate+integral correction to a sane fraction of
           the 0-0.8 rad total collective-ctrl-rad range, independent
           of the much looser +-1.0 clip already on ap/total-collective-
           cmd's summer downstream (see the "afcs commands" channel);
           added alongside the closed-loop climb-out redesign, where
           ap/altitude-gain is large enough that a full ~100 ft ground-
           level error could otherwise request an unreasonably large
           single-frame correction. -->
      <clipto>
        <min> -0.3 </min>
        <max>  0.3 </max>
      </clipto>
    </fcs_function>
  </channel>

  <!-- Speed hold -->
  <channel name="speed hold">
    <fcs_function name="ap/speed-error-fps">
      <function>
        <difference>
          <property> ap/speed-target-fps </property>
          <property> velocities/vt-fps </property>
        </difference>
      </function>
    </fcs_function>

    <fcs_function name="ap/speed-collective-cmd">
      <function>
        <product>
          <property> ap/speed-error-fps </property>
          <value> 0.005 </value>
          <property> ap/speed-hold-on </property>
        </product>
      </function>
    </fcs_function>
  </channel>

  <!-- Stability augmentation -->
  <channel name="stability augmentation">
    <fcs_function name="ap/sas-pitch-cmd">
      <function>
        <product>
          <property> velocities/q-rad_sec </property>
          <value> -0.1 </value>
          <property> ap/stability-aug-on </property>
        </product>
      </function>
    </fcs_function>

    <fcs_function name="ap/sas-roll-cmd">
      <function>
        <product>
          <property> velocities/p-rad_sec </property>
          <value> -0.1 </value>
          <property> ap/stability-aug-on </property>
        </product>
      </function>
    </fcs_function>

    <fcs_function name="ap/sas-yaw-cmd">
      <function>
        <product>
          <property> velocities/r-rad_sec </property>
          <value> -0.05 </value>
          <property> ap/stability-aug-on </property>
        </product>
      </function>
    </fcs_function>
  </channel>

  <!-- Combined AFCS commands -->
  <channel name="afcs commands">
    <summer name="ap/total-elevator-cmd">
      <input> ap/elevator-cmd </input>
      <input> ap/sas-pitch-cmd </input>
      <clipto>
        <min> -1.0 </min>
        <max>  1.0 </max>
      </clipto>
      <output> ap/elevator-cmd </output>
    </summer>

    <summer name="ap/total-aileron-cmd">
      <input> ap/aileron-cmd </input>
      <input> ap/sas-roll-cmd </input>
      <clipto>
        <min> -1.0 </min>
        <max>  1.0 </max>
      </clipto>
      <output> ap/aileron-cmd </output>
    </summer>

    <summer name="ap/total-rudder-cmd">
      <input> ap/rudder-cmd </input>
      <input> ap/sas-yaw-cmd </input>
      <clipto>
        <min> -1.0 </min>
        <max>  1.0 </max>
      </clipto>
      <output> ap/rudder-cmd </output>
    </summer>

    <summer name="ap/total-collective-cmd">
      <input> ap/collective-cmd </input>
      <input> ap/speed-collective-cmd </input>
      <clipto>
        <min> -1.0 </min>
        <max>  1.0 </max>
      </clipto>
      <output> ap/collective-cmd </output>
    </summer>
  </channel>

</system>
