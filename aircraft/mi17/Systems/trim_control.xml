<system name="trim_control">

  <!-- Mi-17 Trim Control System -->
  <!-- 
       The Mi-17 has trim controls for:
       - Collective trim
       - Pitch trim
       - Roll trim
       - Yaw trim
  -->

  <!-- Trim properties -->
  <property value="0.0"> fcs/collective-trim-cmd-norm </property>
  <property value="0.0"> fcs/pitch-trim-cmd-norm </property>
  <property value="0.0"> fcs/roll-trim-cmd-norm </property>
  <property value="0.0"> fcs/yaw-trim-cmd-norm </property>

  <!-- Trim limits -->
  <property value="0.3"> fcs/collective-trim-limit </property>
  <property value="0.2"> fcs/pitch-trim-limit </property>
  <property value="0.15"> fcs/roll-trim-limit </property>
  <property value="0.2"> fcs/yaw-trim-limit </property>

  <!-- Trim rate -->
  <property value="0.1"> fcs/trim-rate </property>

  <!-- Collective trim -->
  <channel name="collective trim">
    <fcs_function name="fcs/collective-trim-limited">
      <function>
        <table>
          <independentVar> fcs/collective-trim-cmd-norm </independentVar>
          <tableData>
            -1.0   -0.3
            -0.5   -0.15
             0.0    0.0
             0.5    0.15
             1.0    0.3
          </tableData>
        </table>
      </function>
    </fcs_function>

    <lag_filter name="fcs/collective-trim-lag">
      <input> fcs/collective-trim-limited </input>
      <c1> 5.0 </c1>
      <output> fcs/collective-trim-norm </output>
    </lag_filter>
  </channel>

  <!-- Pitch trim -->
  <channel name="pitch trim">
    <fcs_function name="fcs/pitch-trim-limited">
      <function>
        <table>
          <independentVar> fcs/pitch-trim-cmd-norm </independentVar>
          <tableData>
            -1.0   -0.2
            -0.5   -0.1
             0.0    0.0
             0.5    0.1
             1.0    0.2
          </tableData>
        </table>
      </function>
    </fcs_function>

    <lag_filter name="fcs/pitch-trim-lag">
      <input> fcs/pitch-trim-limited </input>
      <c1> 5.0 </c1>
      <output> fcs/pitch-trim-norm </output>
    </lag_filter>
  </channel>

  <!-- Roll trim -->
  <channel name="roll trim">
    <fcs_function name="fcs/roll-trim-limited">
      <function>
        <table>
          <independentVar> fcs/roll-trim-cmd-norm </independentVar>
          <tableData>
            -1.0   -0.15
            -0.5   -0.075
             0.0    0.0
             0.5    0.075
             1.0    0.15
          </tableData>
        </table>
      </function>
    </fcs_function>

    <lag_filter name="fcs/roll-trim-lag">
      <input> fcs/roll-trim-limited </input>
      <c1> 5.0 </c1>
      <output> fcs/roll-trim-norm </output>
    </lag_filter>
  </channel>

  <!-- Yaw trim -->
  <channel name="yaw trim">
    <fcs_function name="fcs/yaw-trim-limited">
      <function>
        <table>
          <independentVar> fcs/yaw-trim-cmd-norm </independentVar>
          <tableData>
            -1.0   -0.2
            -0.5   -0.1
             0.0    0.0
             0.5    0.1
             1.0    0.2
          </tableData>
        </table>
      </function>
    </fcs_function>

    <lag_filter name="fcs/yaw-trim-lag">
      <input> fcs/yaw-trim-limited </input>
      <c1> 5.0 </c1>
      <output> fcs/yaw-trim-norm </output>
    </lag_filter>
  </channel>

  <!-- Trim indicators -->
  <channel name="trim indicators">
    <fcs_function name="fcs/collective-trim-indicator">
      <function>
        <product>
          <value> 100.0 </value>
          <property> fcs/collective-trim-norm </property>
        </product>
      </function>
    </fcs_function>

    <fcs_function name="fcs/pitch-trim-indicator">
      <function>
        <product>
          <value> 100.0 </value>
          <property> fcs/pitch-trim-norm </property>
        </product>
      </function>
    </fcs_function>

    <fcs_function name="fcs/roll-trim-indicator">
      <function>
        <product>
          <value> 100.0 </value>
          <property> fcs/roll-trim-norm </property>
        </product>
      </function>
    </fcs_function>

    <fcs_function name="fcs/yaw-trim-indicator">
      <function>
        <product>
          <value> 100.0 </value>
          <property> fcs/yaw-trim-norm </property>
        </product>
      </function>
    </fcs_function>
  </channel>

  <!-- Auto-trim functionality -->
  <channel name="auto trim">
    <fcs_function name="fcs/auto-trim-enabled">
      <function>
        <table>
          <independentVar> velocities/vt-fps </independentVar>
          <tableData>
            0.0    0.0
            20.0   0.0
            30.0   1.0
            50.0   1.0
          </tableData>
        </table>
      </function>
    </fcs_function>

    <!-- Auto-trim based on attitude -->
    <fcs_function name="fcs/auto-pitch-trim">
      <function>
        <product>
          <property> attitude/pitch-rad </property>
          <value> 0.1 </value>
          <property> fcs/auto-trim-enabled </property>
        </product>
      </function>
    </fcs_function>

    <fcs_function name="fcs/auto-roll-trim">
      <function>
        <product>
          <property> attitude/roll-rad </property>
          <value> 0.1 </value>
          <property> fcs/auto-trim-enabled </property>
        </product>
      </function>
    </fcs_function>
  </channel>

</system>
