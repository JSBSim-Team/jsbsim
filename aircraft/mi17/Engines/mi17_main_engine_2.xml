<?xml version="1.0"?>

<!--
  Mi-17 main rotor drive, side 2 of 2. Identical tables to
  mi17_main_engine_1.xml (same TV3-117MT side); see that file for the
  full derivation/rationale, including why this is <turboshaft_engine>
  (FGTurboshaft) rather than <turboprop_engine> (FGTurboProp). Combined
  with side 1 through <gearbox name="mi17-main-gearbox"> in mi17.xml.
-->
<turboshaft_engine name="mi17_main_engine_2">
  <idlen1>                       60.0   </idlen1>
  <maxn1>                       100.0   </maxn1>
  <!-- maxpower=2200 (real TV3-117VM MAX RATED, W/O PSS); see
       mi17_main_engine_1.xml for the full derivation. -->
  <maxpower unit="HP">         2200.0   </maxpower>
  <psfc unit="LBS/HR/HP">         0.55  </psfc>
  <n1idle_max_delay>              1     </n1idle_max_delay>
  <maxstartingtime>              20     </maxstartingtime>
  <startern1>                    20     </startern1>
  <!-- ielumaxtorque intentionally omitted; see mi17_main_engine_1.xml
       for why (torque = power/omega spikes at low startup RPM, and the
       old 2100 FT*LB limit tripped on that legitimate transient). -->
  <itt_delay>                     0.05  </itt_delay>

  <table name="EnginePowerVC">
    <description> Engine power, function of airspeed and pressure </description>
    <independentVar lookup="row">atmosphere/P-psf</independentVar>
    <independentVar lookup="column">velocities/ve-kts</independentVar>
    <tableData>
                 0     50    100    150    200    250
       503   0.357  0.380  0.400  0.425  0.457  0.486
      1048   0.586  0.589  0.600  0.621  0.650  0.686
      1328   0.707  0.721  0.731  0.757  0.786  0.821
      1496   0.779  0.786  0.808  0.821  0.857  0.900
      1684   0.850  0.857  0.874  0.900  0.943  0.979
      1896   0.914  0.929  0.946  0.971  1      1.057
      2135   1      1.011  1.029  1.043  1.083  1.150
      2213   1.029  1.043  1.057  1.079  1.114  1.171
    </tableData>
  </table>

  <table name="EnginePowerRPM_N1" type="internal">
    <description>
      Per-side engine power [HP], function of EngineRPM (rotor RPM x
      gearratio 78.125) and N1 [%]. Nominal main-rotor speed (192 RPM)
      corresponds to EngineRPM 15000, between the 14114 and 15616 rows.
      Row axis rescaled by 15000/4995 from the old 18.5/270 placeholder
      gearing to the real Mi-17 78.125/192 figures; see the identical
      table in mi17_main_engine_1.xml for the full rationale.
    </description>
    <tableData>
              0     5     60     86     94     95     96     97     98     99    100    101
         0    0   1.4    1.4    1.4    1.4    1.4    1.4    1.4    1.4    1.4    1.4    1.4
