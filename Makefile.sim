# =============================================================================
# Makefile.sim -- sim-team build/CI pipeline for the JSBSim fork
#
# All pipeline logic lives HERE. .github/workflows/sim-ci.yml is a thin
# wrapper that only provisions the runner and calls `make -f Makefile.sim ci`.
# If `make -f Makefile.sim ci` passes locally, CI must pass.
#
# This file is deliberately named Makefile.sim so it can never collide with
# upstream (JSBSim-Team/jsbsim) files. Invoke every target as:
#
#     make -f Makefile.sim <target>
#
# Standard target contract (stable across all sim teams):
#     setup                verify toolchain deps; print install commands for
#                          anything missing (never sudo-installs).
#                            Linux:   cmake, g++/clang++, make, git, python
#                                     (real interpreter, see PYTHON below)
#                            Windows: vswhere.exe -> MSBuild.exe, git, python
#                                     (cmake/g++/make-as-build-tool are NOT
#                                     needed on this path and are not checked)
#     build                Linux:   cmake configure + build into build/
#                          Windows: MSBuild via the Unreal/Visual-Studio
#                                   toolchain (JSBSim.sln Release|x64, then
#                                   JSBSimForUnreal.sln 1_Release|x64 and
#                                   2_Debug|x64) -- NOT cmake+gcc
#     test                 Linux:   ctest unit/functional tests
#                          Windows: SKIPPED (prominent banner) -- no cmake/
#                                   cxxtest/python-module configure step on
#                                   this path; test-regression is the local
#                                   substitute
#     test-regression      fast check_cases subset + our scripts/test_*.xml
#                          (feature-branch scope)
#     test-regression-full full check_cases suite incl. reference-data
#                          comparison (sim-main scope)
#     lint                 checks on OUR changes only (diff vs master);
#                          never reformats/flags untouched upstream code
#     ci                   Linux:   setup + build + test + test-regression + lint
#                          Windows: setup + build + test-regression + lint
#                                   (test dropped -- SKIPPED is never silently
#                                   swallowed into a pass)
#     ci-full              like ci, but with test-regression-full
#     clean                Linux: remove build/. Windows: remove the MSBuild
#                          output dirs (Release/, Debug/, x64/) -- there is
#                          no build/ dir on that path
#
# PYTHON: on some Windows machines, `python3`/`python` on PATH resolve to
# Windows Store execution-alias stubs that exit non-zero instead of running --
# a `command -v` presence check is not enough. Every target below uses the
# $(PYTHON) variable (computed once by actually invoking the interpreter),
# never a hardcoded `python3`.
# =============================================================================

SHELL       := /usr/bin/env bash
.SHELLFLAGS := -eu -o pipefail -c
MAKEFLAGS   += --no-builtin-rules

# Make-level OS branch (no shell-out) -- Windows_NT is set by the real
# Windows environment and inherited by Git Bash/MSYS2 regardless of which
# shell launched make.
IS_WINDOWS  := $(filter Windows_NT,$(OS))

REPO_ROOT   := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
BUILD_DIR   ?= $(REPO_ROOT)/build
JOBS        ?= $(shell nproc 2>/dev/null || echo 2)

# Ref our changes are linted against. If it does not exist locally (shallow
# CI checkouts), origin/$(BASE_REF) is tried before giving up.
BASE_REF    ?= master

CMAKE_BUILD_TYPE ?= RelWithDebInfo
CMAKE_FLAGS      ?= -DCMAKE_BUILD_TYPE=$(CMAKE_BUILD_TYPE) -DBUILD_PYTHON_MODULE=ON

# PYTHON is resolved once, by actually invoking the interpreter (a
# `command -v` presence check is not enough -- see the PYTHON note above).
# python3 wins if it actually runs; otherwise fall back to python.
PYTHON      := $(shell python3 -c "print(1)" >/dev/null 2>&1 && echo python3 || echo python)

ifeq ($(IS_WINDOWS),1)
JSBSIM_BIN  := $(REPO_ROOT)/Release/JSBSim.exe
VSWHERE     := C:/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe
MSBUILD_WIN := $(shell "$(VSWHERE)" -latest -products '*' -requires Microsoft.Component.MSBuild -find MSBuild\**\Bin\MSBuild.exe 2>/dev/null | head -n1)
WIN_REPO_ROOT := $(shell cygpath -w "$(REPO_ROOT)" 2>/dev/null)
else
JSBSIM_BIN  := $(BUILD_DIR)/src/JSBSim
endif
REG_DIR     := $(BUILD_DIR)/regression
REG_TOL     ?= 1e-5

# check_cases/ subdirectories to run. FAST is the feature-branch subset;
# FULL adds the long-running orbit case and reference CSV comparison.
CHECK_CASES_FAST := ground_tests piston_takeoff
CHECK_CASES_FULL := ground_tests piston_takeoff orbit

.PHONY: setup build test test-regression test-regression-full lint \
        ci ci-full clean help _run-regression

# -----------------------------------------------------------------------------
# Aggregate targets (fail fast: make stops at the first failing prerequisite)
# Windows drops `test` (SKIPPED, see the target below) rather than silently
# swallowing it into a pass -- ci/ci-full are NOT identical across OSes.
# -----------------------------------------------------------------------------
ifeq ($(IS_WINDOWS),1)
ci: setup build test-regression lint
	@echo "== ci: PASSED (setup, build, test-regression, lint) -- test SKIPPED on Windows, see 'make -f Makefile.sim test' =="

ci-full: setup build test-regression-full lint
	@echo "== ci-full: PASSED (setup, build, test-regression-full, lint) -- test SKIPPED on Windows, see 'make -f Makefile.sim test' =="
else
ci: setup build test test-regression lint
	@echo "== ci: all stages passed =="

ci-full: setup build test test-regression-full lint
	@echo "== ci-full: all stages passed =="
endif

help:
	@echo "Usage: make -f Makefile.sim <target>"
	@echo "Targets: setup build test test-regression test-regression-full lint ci ci-full clean"
	@echo "Docs:    docs/setup/ci-jsbsim.md (umbrella repo)"

# -----------------------------------------------------------------------------
# setup -- verify the toolchain. Prints exact install commands for anything
# missing. Never sudo-installs. Required tools missing => exit 1. Optional
# deps only produce warnings.
#   Linux:   cmake, g++/clang++, make, git, python (real interpreter)
#   Windows: vswhere.exe -> MSBuild.exe (via VS2022), git, python. cmake/g++/
#            make-as-build-tool are not needed on this path and not checked.
# -----------------------------------------------------------------------------
ifeq ($(IS_WINDOWS),1)
setup:
	@echo "== setup: verifying toolchain (Windows / MSBuild path) =="
	@missing=""; \
	if [ ! -f "$(VSWHERE)" ]; then \
	    echo "MISSING (required): vswhere.exe not found at '$(VSWHERE)'"; \
	    echo "  Install Visual Studio 2022 (Community is free, ships vswhere.exe)."; \
	    missing="$$missing vswhere"; \
	elif [ -z "$(MSBUILD_WIN)" ]; then \
	    echo "MISSING (required): MSBuild.exe (vswhere found no install with the MSBuild component)"; \
	    missing="$$missing msbuild"; \
	else \
	    echo "ok   : MSBuild.exe -> $(MSBUILD_WIN)"; \
	fi; \
	if [ -n "$$missing" ]; then \
	    echo ""; \
	    echo "  Install Visual Studio 2022 (free Community edition is fine) with the"; \
	    echo "  'Desktop development with C++' workload, then in the VS Installer ->"; \
	    echo "  Individual Components, add BOTH of these (they are not installed by"; \
	    echo "  default and both .sln files in this repo need them):"; \
	    echo "    - MSVC v142 - VS 2019 C++ x64/x86 build tools   (needed by JSBSimForUnreal.vcxproj)"; \
	    echo "    - MSVC v143 x64/x86 build tools (v14.38-17.X)   (needed by JSBSim.vcxproj; must be"; \
	    echo "      this specific v14.38 sub-version, not just 'latest v143' -- UE5.4/5.5 pin it)"; \
	fi; \
	command -v git >/dev/null || { echo "MISSING (required): git"; missing="$$missing git"; }; \
	if $(PYTHON) -c "print(1)" >/dev/null 2>&1; then \
	    echo "ok   : python -> $$(command -v $(PYTHON)) ($$($(PYTHON) -c 'import sys; print(sys.version.split()[0])'))"; \
	else \
	    echo "MISSING (required): a working python -- 'python3'/'python' on PATH resolve to a"; \
	    echo "  Windows Store execution-alias stub, not a real interpreter (it passes a"; \
	    echo "  'command -v' presence check but exits without running anything). Install"; \
	    echo "  Python from python.org (check 'Add python.exe to PATH'), or disable the stub"; \
	    echo "  at Settings > Apps > Advanced app settings > App execution aliases."; \
	    missing="$$missing python"; \
	fi; \
	if [ -n "$$missing" ]; then echo ""; echo "setup: FAILED -- required tools missing:$$missing"; exit 1; fi; \
	echo "setup: OK"
else
setup:
	@echo "== setup: verifying toolchain =="
	@missing_pkgs=""; \
	command -v cmake   >/dev/null || { echo "MISSING (required): cmake";              missing_pkgs="$$missing_pkgs cmake"; }; \
	command -v g++     >/dev/null || command -v clang++ >/dev/null \
	                              || { echo "MISSING (required): C++ compiler (g++)"; missing_pkgs="$$missing_pkgs g++"; }; \
	command -v make    >/dev/null || { echo "MISSING (required): make";               missing_pkgs="$$missing_pkgs make"; }; \
	command -v git     >/dev/null || { echo "MISSING (required): git";                missing_pkgs="$$missing_pkgs git"; }; \
	if $(PYTHON) -c "print(1)" >/dev/null 2>&1; then \
	    : ; \
	else \
	    echo "MISSING (required): a working python3/python interpreter"; \
	    missing_pkgs="$$missing_pkgs python3"; \
	fi; \
	command -v cxxtestgen >/dev/null \
	    || echo "WARNING (optional): cxxtest not found -- C++ unit tests will not be built."$$'\n'"  install with: sudo apt-get install -y cxxtest"; \
	if $(PYTHON) -m pip --version >/dev/null 2>&1; then \
	    echo "-- installing/verifying python deps (requirements-sim.txt, user-level, no sudo)"; \
	    $(PYTHON) -m pip install --disable-pip-version-check -q -r $(REPO_ROOT)/requirements-sim.txt \
	    || echo "WARNING (optional): could not pip-install python deps (externally-managed env?)."$$'\n'"  Use a venv: $(PYTHON) -m venv ~/.venvs/jsbsim && source ~/.venvs/jsbsim/bin/activate && pip install -r requirements-sim.txt"$$'\n'"  Without cython+numpy+pandas+scipy the python module and its ctest suite are skipped."; \
	else \
	    echo "WARNING (optional): pip not available -- python module tests will be skipped."; \
	    echo "  install with: sudo apt-get install -y python3-pip python3-venv"; \
	fi; \
	if [ -n "$$missing_pkgs" ]; then \
	    echo ""; \
	    echo "setup: FAILED -- required tools missing:$$missing_pkgs"; \
	    echo "  install with: sudo apt-get update && sudo apt-get install -y$$missing_pkgs"; \
	    echo "  (this target never installs system packages itself)"; \
	    exit 1; \
	fi; \
	echo "setup: OK (cmake $$(cmake --version | head -n1 | awk '{print $$3}'), $$(g++ --version 2>/dev/null | head -n1 || clang++ --version | head -n1), python $$($(PYTHON) -c 'import sys; print(sys.version.split()[0])'))"
endif

# -----------------------------------------------------------------------------
# build
#   Linux:   cmake configure + compile into build/
#   Windows: MSBuild via the Unreal/Visual-Studio toolchain -- JSBSim.sln
#            (Release|x64, produces Release/JSBSim.exe for test-regression)
#            then JSBSimForUnreal.sln, BOTH 1_Release|x64 and 2_Debug|x64
#            (exact solution-config names -- stages the UE-plugin-consumable
#            lib/dll into UnrealEngine/Plugins/.../ThirdParty/JSBSim/; the
#            Debug config must also be built or a UE DebugGame build breaks,
#            since JSBSim.Build.cs only looks in LibDebug/ for that config).
#            NOT cmake+gcc on this path. Repo paths are converted with
#            cygpath -w before being passed to MSBuild -- it's a native tool
#            and doesn't reliably parse MSYS/Git-Bash POSIX paths.
# -----------------------------------------------------------------------------
ifeq ($(IS_WINDOWS),1)
build:
	@echo "== build: MSBuild JSBSim.sln (Release|x64) =="
	"$(MSBUILD_WIN)" "$(WIN_REPO_ROOT)\JSBSim.sln" -p:Configuration=Release -p:Platform=x64 -m -nologo
	@echo "== build: MSBuild JSBSimForUnreal.sln (1_Release|x64) =="
	"$(MSBUILD_WIN)" "$(WIN_REPO_ROOT)\JSBSimForUnreal.sln" -p:Configuration=1_Release -p:Platform=x64 -m -nologo
	@echo "== build: MSBuild JSBSimForUnreal.sln (2_Debug|x64) =="
	"$(MSBUILD_WIN)" "$(WIN_REPO_ROOT)\JSBSimForUnreal.sln" -p:Configuration=2_Debug -p:Platform=x64 -m -nologo
	@echo "build: OK ($(JSBSIM_BIN); UE plugin ThirdParty lib staged)"
else
build:
	@echo "== build: cmake configure + build ($(CMAKE_BUILD_TYPE), -j$(JOBS)) =="
	cmake -S $(REPO_ROOT) -B $(BUILD_DIR) $(CMAKE_FLAGS)
	cmake --build $(BUILD_DIR) -j $(JOBS)
endif

# -----------------------------------------------------------------------------
# test -- unit/functional tests via ctest.
# Registered tests depend on what was available at configure time:
# cxxtest => C++ unit tests, cython/numpy/pandas => python test suite.
#
# Windows: SKIPPED, not a silent pass. Neither JSBSim.sln nor
# JSBSimForUnreal.sln has a test project -- cxxtest and the python-module
# ctest suite are both wired through the cmake configure step, which this
# path deliberately avoids (MSVC/UBT toolchain, not cmake+gcc). Reintroducing
# cmake+gcc just for this one target would mean a second, separate compiler
# and build tree -- two sources of truth for "does it compile" -- for
# marginal benefit. test-regression (which DOES run for real on Windows
# against the MSBuild-produced JSBSim.exe) is the local substitute; ci/ci-full
# drop `test` from the aggregate on Windows rather than swallowing it.
# -----------------------------------------------------------------------------
ifeq ($(IS_WINDOWS),1)
test:
	@echo ""
	@echo "################################################################"
	@echo "##                                                            ##"
	@echo "##   SKIPPED: JSBSim C++/python unit tests (ctest)            ##"
	@echo "##                                                            ##"
	@echo "##   This target requires the Linux/cmake+cxxtest CI path.    ##"
	@echo "##   The Windows build uses MSBuild (JSBSim.sln +             ##"
	@echo "##   JSBSimForUnreal.sln), which has no test project.         ##"
	@echo "##   Use 'make -f Makefile.sim test-regression' for local     ##"
	@echo "##   verification on Windows instead.                        ##"
	@echo "##                                                            ##"
	@echo "################################################################"
	@echo "== test: SKIPPED (Windows -- no cmake/cxxtest on this path) =="
else
test:
	@echo "== test: ctest (-j$(JOBS)) =="
	@if [ ! -f $(BUILD_DIR)/CTestTestfile.cmake ]; then \
	    echo "test: FAILED -- no ctest configuration in $(BUILD_DIR); run 'make -f Makefile.sim build' first"; \
	    exit 1; \
	fi
	cd $(BUILD_DIR) && ctest --output-on-failure --no-tests=error -j $(JOBS)
endif

# -----------------------------------------------------------------------------
# test-regression / test-regression-full
#
# Runs the JSBSim binary directly (no python module needed) on:
#   1. check_cases/<case>/scripts/*.xml  -- each case dir is copied into
#      build/regression/<case> so the source tree is never dirtied by the
#      CSV outputs JSBSim writes into its root dir.
#   2. OUR aircraft regression scripts scripts/test_*.xml (files WE add; the
#      upstream *_test.xml scripts are not ours and are not run here). These
#      run against a copied-tree root in build/regression/repo-scripts (a
#      plain `cp -r`, not a symlink farm -- symlinks are unreliable/
#      unprivileged on Windows, and REG_DIR is wiped+rebuilt every run so
#      there's no dirtying downside to copying on any OS), so our scripts
#      must write outputs to bare filenames (no data_output/).
#
# The full variant additionally compares every produced CSV against the
# matching file in check_cases/<case>/logged_data/ with tolerance REG_TOL,
# mirroring upstream's RunCheckCases.py acceptance criterion (1e-5).
# -----------------------------------------------------------------------------
test-regression: CASES := $(CHECK_CASES_FAST)
test-regression: COMPARE := 0
test-regression: _run-regression

test-regression-full: CASES := $(CHECK_CASES_FULL)
test-regression-full: COMPARE := 1
test-regression-full: _run-regression

# Stdlib-only CSV comparator (ref, current, tolerance). No pandas dependency.
define COMPARE_PY
import csv, sys
ref_path, cur_path, tol = sys.argv[1], sys.argv[2], float(sys.argv[3])
def load(path):
    with open(path, newline="") as f:
        rows = list(csv.reader(f))
    return [c.strip() for c in rows[0]], rows[1:]
ref_hdr, ref = load(ref_path)
cur_hdr, cur = load(cur_path)
if ref_hdr != cur_hdr:
    sys.exit("compare: column mismatch between " + ref_path + " and " + cur_path)
if len(ref) != len(cur):
    sys.exit("compare: row count mismatch: ref=" + str(len(ref)) + " cur=" + str(len(cur)))
bad = 0
for i, (r, c) in enumerate(zip(ref, cur)):
    for j, (a, b) in enumerate(zip(r, c)):
        try:
            x, y = float(a), float(b)
        except ValueError:
            if a.strip() != b.strip():
                bad += 1
            continue
        if abs(x - y) > tol:
            bad += 1
            if bad <= 10:
                print("compare: row %d col '%s': ref=%g cur=%g |diff|=%g"
                      % (i + 2, ref_hdr[j], x, y, abs(x - y)))
if bad:
    sys.exit("compare: FAILED -- %d value(s) differ by more than %g" % (bad, tol))
print("compare: OK (%d rows, tol %g)" % (len(ref), tol))
endef
export COMPARE_PY

_run-regression:
	@echo "== test-regression: cases [$(CASES)] compare=$(COMPARE) tol=$(REG_TOL) =="
	@if [ ! -f $(JSBSIM_BIN) ]; then \
	    echo "test-regression: FAILED -- $(JSBSIM_BIN) not found; run 'make -f Makefile.sim build' first"; \
	    exit 1; \
	fi
	@fail=0; \
	for case in $(CASES); do \
	    src=$(REPO_ROOT)/check_cases/$$case; dst=$(REG_DIR)/$$case; \
	    rm -rf "$$dst"; mkdir -p $(REG_DIR); cp -r "$$src" "$$dst"; \
	    for script in "$$dst"/scripts/*.xml; do \
	        name=$$(basename "$$script"); \
	        echo "[regression] check_case $$case :: $$name"; \
	        if ! (cd "$$dst" && $(JSBSIM_BIN) --root=./ --script=scripts/$$name > "$$name.log" 2>&1); then \
	            echo "[regression] FAIL: $$case/$$name (JSBSim exited non-zero) -- last 40 log lines:"; \
	            tail -n 40 "$$dst/$$name.log"; \
	            fail=1; \
	        fi; \
	    done; \
	    if [ "$(COMPARE)" = "1" ] && [ -d "$$src/logged_data" ]; then \
	        for ref in "$$src"/logged_data/*.csv; do \
	            out="$$dst/$$(basename "$$ref")"; \
	            if [ -f "$$out" ]; then \
	                echo "[regression] check_case $$case :: compare $$(basename "$$ref")"; \
	                $(PYTHON) -c "$$COMPARE_PY" "$$ref" "$$out" $(REG_TOL) || fail=1; \
	            fi; \
	        done; \
	    fi; \
	done; \
	shopt -s nullglob; own_scripts=($(REPO_ROOT)/scripts/test_*.xml); \
	if [ $${#own_scripts[@]} -eq 0 ]; then \
	    echo "[regression] no scripts/test_*.xml present yet -- skipping fork aircraft regressions"; \
	else \
	    dst=$(REG_DIR)/repo-scripts; rm -rf "$$dst"; mkdir -p "$$dst"; \
	    for d in aircraft engine systems scripts; do \
	        [ -d $(REPO_ROOT)/$$d ] && cp -r $(REPO_ROOT)/$$d "$$dst/$$d"; \
	    done; \
	    for script in "$${own_scripts[@]}"; do \
	        name=$$(basename "$$script"); \
	        echo "[regression] fork script :: $$name"; \
	        if ! (cd "$$dst" && $(JSBSIM_BIN) --root=./ --script=scripts/$$name > "$$name.log" 2>&1); then \
	            echo "[regression] FAIL: scripts/$$name (JSBSim exited non-zero) -- last 40 log lines:"; \
	            tail -n 40 "$$dst/$$name.log"; \
	            fail=1; \
	        fi; \
	    done; \
	fi; \
	if [ $$fail -ne 0 ]; then echo "test-regression: FAILED"; exit 1; fi; \
	echo "test-regression: OK"

# -----------------------------------------------------------------------------
# lint -- checks OUR changes only, relative to $(BASE_REF).
#   * whitespace errors on changed lines only (git diff --check)
#   * python syntax (ast.parse -- leaves no .pyc files behind)
#   * XML well-formedness (stdlib)
#   * YAML validity (only if PyYAML is installed)
#   * clang-format on files we ADDED only -- modified upstream files are
#     never style-checked, so upstream code is never reformatted/flagged.
# -----------------------------------------------------------------------------
lint:
	@echo "== lint: checking changes relative to $(BASE_REF) =="
	@cd $(REPO_ROOT); \
	base="$(BASE_REF)"; \
	git rev-parse -q --verify "$$base^{commit}" >/dev/null || base="origin/$(BASE_REF)"; \
	if ! git rev-parse -q --verify "$$base^{commit}" >/dev/null; then \
	    echo "lint: base ref '$(BASE_REF)' (and origin/$(BASE_REF)) not found -- skipping"; \
	    exit 0; \
	fi; \
	merge_base=$$(git merge-base "$$base" HEAD); \
	changed=$$(git diff --name-only --diff-filter=ACMR "$$merge_base" HEAD); \
	added=$$(git diff --name-only --diff-filter=A "$$merge_base" HEAD); \
	if [ -z "$$changed" ]; then echo "lint: no changes relative to $$base -- nothing to lint"; exit 0; fi; \
	echo "$$changed" | sed 's/^/  changed: /'; \
	fail=0; \
	git diff --check "$$merge_base" HEAD || { echo "lint: whitespace errors on changed lines (see above)"; fail=1; }; \
	for f in $$changed; do \
	    [ -f "$$f" ] || continue; \
	    case "$$f" in \
	        *.py)  $(PYTHON) -c "import ast,sys; ast.parse(open(sys.argv[1]).read(), sys.argv[1])" "$$f" \
	                   || { echo "lint: python syntax error in $$f"; fail=1; } ;; \
	        *.xml) $(PYTHON) -c "import sys,xml.dom.minidom as m; m.parse(sys.argv[1])" "$$f" >/dev/null \
	                   || { echo "lint: malformed XML in $$f"; fail=1; } ;; \
	        *.yml|*.yaml) \
	               if $(PYTHON) -c "import yaml" 2>/dev/null; then \
	                   $(PYTHON) -c "import sys,yaml; list(yaml.safe_load_all(open(sys.argv[1])))" "$$f" \
	                       || { echo "lint: invalid YAML in $$f"; fail=1; }; \
	               else \
	                   echo "lint: note: PyYAML not installed -- skipping YAML check for $$f"; \
	               fi ;; \
	    esac; \
	done; \
	if command -v clang-format >/dev/null; then \
	    for f in $$added; do \
	        [ -f "$$f" ] || continue; \
	        case "$$f" in \
	            *.cpp|*.cxx|*.cc|*.h|*.hpp) \
	                clang-format --dry-run --Werror "$$f" \
	                    || { echo "lint: clang-format violations in $$f (file added by us)"; fail=1; } ;; \
	        esac; \
	    done; \
	else \
	    echo "lint: note: clang-format not installed -- style check on added C++ files skipped"; \
	fi; \
	if [ $$fail -ne 0 ]; then echo "lint: FAILED"; exit 1; fi; \
	echo "lint: OK"

# -----------------------------------------------------------------------------
# clean -- Linux: remove the cmake build/ dir. Windows: remove the MSBuild
# output dirs for both .sln files (Release/, Debug/, x64/ -- already in
# .gitignore); there is no build/ dir on this path.
# -----------------------------------------------------------------------------
ifeq ($(IS_WINDOWS),1)
clean:
	rm -rf "$(REPO_ROOT)/Release" "$(REPO_ROOT)/Debug" "$(REPO_ROOT)/x64"
else
clean:
	rm -rf $(BUILD_DIR)
endif
