<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://jsbsim.sf.net/JSBSimScript.xsl"?>
<runscript
       name="Mi-17 ground run (long-window spin-up trace)"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="http://jsbsim.sf.net/JSBSimScript.xsd">

  <description>
    Ground run: engines started, collective pinned flat (0.0, and the
    fcs/adj/collective-bias default zeroed too) so the aircraft stays
    grounded/chocked while the rotor spins up, over a 60s window with
    reports every 5-10s. Isolates propulsion/RPM spin-up behavior from
    aerodynamic lift/ground-contact instability -- this is what
    exposed the calibration bugs fixed alongside this script (see
    mi17_main_engine_1.xml/mi17_main_engine_2.xml's EnginePowerRPM_N1
    comment, and mi17.xml's gearbox enginemoment/gearmoment comment):
    without pinning collective, an uncontrolled liftoff on a still-
    misbehaving engine model was indistinguishable from a genuine
    ground-contact/flight-dynamics bug. Useful again for any future
    propulsion retuning.
  </description>

  <use aircraft="mi17" initialize="reset00"/>

  <run start="0.0" end="60.0" dt="0.0075">

    <event name="start" persistent="false">
      <condition> simulation/sim-time-sec ge 0.0 </condition>
      <set name="propulsion/set-running" value="-1"/>
      <set name="fcs/collective-cmd-norm" value="0.0"/>
      <set name="fcs/adj/collective-bias" value="0.0"/>
    </event>

    <event name="hold collective flat and throttle up" persistent="true">
      <condition> simulation/sim-time-sec ge 0.0 </condition>
      <set name="fcs/collective-cmd-norm" value="0.0"/>
      <set name="fcs/adj/collective-bias" value="0.0"/>
      <set name="fcs/throttle-cmd-norm[0]" value="1.0"/>
      <set name="fcs/throttle-cmd-norm[1]" value="1.0"/>
    </event>

    <event name="t5" persistent="false">
      <condition> simulation/sim-time-sec ge 5.0 </condition>
      <notify><property>simulation/sim-time-sec</property><property>propulsion/gearbox[0]/shaft-rpm</property><property>propulsion/engine[0]/n1</property><property>propulsion/engine[0]/output-torque-lbft</property><property>propulsion/engine[0]/thrust-lbs</property><property>propulsion/engine[0]/collective-ctrl-rad</property><property>position/h-agl-ft</property></notify>
    </event>
    <event name="t10" persistent="false">
      <condition> simulation/sim-time-sec ge 10.0 </condition>
      <notify><property>simulation/sim-time-sec</property><property>propulsion/gearbox[0]/shaft-rpm</property><property>propulsion/engine[0]/n1</property><property>propulsion/engine[0]/output-torque-lbft</property><property>propulsion/engine[0]/thrust-lbs</property><property>propulsion/engine[0]/collective-ctrl-rad</property><property>position/h-agl-ft</property></notify>
    </event>
    <event name="t15" persistent="false">
      <condition> simulation/sim-time-sec ge 15.0 </condition>
      <notify><property>simulation/sim-time-sec</property><property>propulsion/gearbox[0]/shaft-rpm</property><property>propulsion/engine[0]/n1</property><property>propulsion/engine[0]/output-torque-lbft</property><property>propulsion/engine[0]/thrust-lbs</property><property>propulsion/engine[0]/collective-ctrl-rad</property><property>position/h-agl-ft</property></notify>
    </event>
    <event name="t20" persistent="false">
      <condition> simulation/sim-time-sec ge 20.0 </condition>
      <notify><property>simulation/sim-time-sec</property><property>propulsion/gearbox[0]/shaft-rpm</property><property>propulsion/engine[0]/n1</property><property>propulsion/engine[0]/output-torque-lbft</property><property>propulsion/engine[0]/thrust-lbs</property><property>propulsion/engine[0]/collective-ctrl-rad</property><property>position/h-agl-ft</property></notify>
    </event>
    <event name="t30" persistent="false">
      <condition> simulation/sim-time-sec ge 30.0 </condition>
      <notify><property>simulation/sim-time-sec</property><property>propulsion/gearbox[0]/shaft-rpm</property><property>propulsion/engine[0]/n1</property><property>propulsion/engine[0]/output-torque-lbft</property><property>propulsion/engine[0]/thrust-lbs</property><property>propulsion/engine[0]/collective-ctrl-rad</property><property>position/h-agl-ft</property></notify>
    </event>
    <event name="t40" persistent="false">
      <condition> simulation/sim-time-sec ge 40.0 </condition>
      <notify><property>simulation/sim-time-sec</property><property>propulsion/gearbox[0]/shaft-rpm</property><property>propulsion/engine[0]/n1</property><property>propulsion/engine[0]/output-torque-lbft</property><property>propulsion/engine[0]/thrust-lbs</property><property>propulsion/engine[0]/collective-ctrl-rad</property><property>position/h-agl-ft</property></notify>
    </event>
    <event name="t50" persistent="false">
      <condition> simulation/sim-time-sec ge 50.0 </condition>
      <notify><property>simulation/sim-time-sec</property><property>propulsion/gearbox[0]/shaft-rpm</property><property>propulsion/engine[0]/n1</property><property>propulsion/engine[0]/output-torque-lbft</property><property>propulsion/engine[0]/thrust-lbs</property><property>propulsion/engine[0]/collective-ctrl-rad</property><property>position/h-agl-ft</property></notify>
    </event>
    <event name="t60" persistent="false">
      <condition> simulation/sim-time-sec ge 59.9 </condition>
      <notify><property>simulation/sim-time-sec</property><property>propulsion/gearbox[0]/shaft-rpm</property><property>propulsion/engine[0]/n1</property><property>propulsion/engine[0]/output-torque-lbft</property><property>propulsion/engine[0]/thrust-lbs</property><property>propulsion/engine[0]/collective-ctrl-rad</property><property>position/h-agl-ft</property></notify>
    </event>

  </run>

</runscript>
