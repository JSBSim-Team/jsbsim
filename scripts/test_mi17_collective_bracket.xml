<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://jsbsim.sf.net/JSBSimScript.xsl"?>
<runscript
       name="Mi-17 collective bracketing / attitude stability check"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="http://jsbsim.sf.net/JSBSimScript.xsd">

  <description>
    Steps fcs/collective-cmd-norm through fixed values with
    ap/attitude-hold-on engaged, reporting thrust/vertical-speed/h-agl/
    pitch/roll/yaw-rate/heading at each step. Originally written to find
    roughly what collective balances this model's ~14000 lb gross
    weight; became the diagnostic that surfaced this branch's ground-
    contact instability chain (RPM governor never wired to throttle,
    placeholder gear ratios/RPMs, an FGLGear.cpp division-near-zero
    singularity, and an inverted nose-gear-vs-CG layout -- all fixed).
    Kept as a quick attitude/yaw-stability regression check: with all of
    those fixed, roll stays under ~0.002 rad and yaw rate near zero
    across the full collective sweep and 60s runtime. Default
    collective-bias (0.15) is left in place, not zeroed, since we want
    positive lift this time.
  </description>

  <use aircraft="mi17" initialize="reset00"/>

  <run start="0.0" end="60.0" dt="0.0075">

    <event name="start" persistent="false">
      <condition> simulation/sim-time-sec ge 0.0 </condition>
      <set name="propulsion/set-running" value="-1"/>
      <set name="fcs/collective-cmd-norm" value="0.0"/>
      <set name="ap/attitude-hold-on" value="1.0"/>
    </event>

    <event name="hold throttle up and attitude" persistent="true">
      <condition> simulation/sim-time-sec ge 0.0 </condition>
      <set name="fcs/throttle-cmd-norm[0]" value="1.0"/>
      <set name="fcs/throttle-cmd-norm[1]" value="1.0"/>
      <set name="ap/attitude-hold-on" value="1.0"/>
    </event>

    <event name="collective 0.0" persistent="false">
      <condition> simulation/sim-time-sec ge 8.0 </condition>
      <set name="fcs/collective-cmd-norm" value="0.0"/>
      <notify><property>simulation/sim-time-sec</property><property>fcs/collective-cmd-norm</property><property>propulsion/engine[0]/collective-ctrl-rad</property><property>propulsion/engine[0]/thrust-lbs</property><property>velocities/v-down-fps</property><property>position/h-agl-ft</property><property>attitude/pitch-rad</property><property>attitude/roll-rad</property><property>velocities/vt-fps</property><property>velocities/r-rad_sec</property><property>attitude/psi-deg</property></notify>
    </event>
    <event name="collective 0.1" persistent="false">
      <condition> simulation/sim-time-sec ge 15.0 </condition>
      <set name="fcs/collective-cmd-norm" value="0.1"/>
    </event>
    <event name="report 0.1" persistent="false">
      <condition> simulation/sim-time-sec ge 22.0 </condition>
      <notify><property>simulation/sim-time-sec</property><property>fcs/collective-cmd-norm</property><property>propulsion/engine[0]/collective-ctrl-rad</property><property>propulsion/engine[0]/thrust-lbs</property><property>velocities/v-down-fps</property><property>position/h-agl-ft</property><property>attitude/pitch-rad</property><property>attitude/roll-rad</property><property>velocities/vt-fps</property><property>velocities/r-rad_sec</property><property>attitude/psi-deg</property></notify>
    </event>
    <event name="collective 0.2" persistent="false">
      <condition> simulation/sim-time-sec ge 29.0 </condition>
      <set name="fcs/collective-cmd-norm" value="0.2"/>
    </event>
    <event name="report 0.2" persistent="false">
      <condition> simulation/sim-time-sec ge 36.0 </condition>
      <notify><property>simulation/sim-time-sec</property><property>fcs/collective-cmd-norm</property><property>propulsion/engine[0]/collective-ctrl-rad</property><property>propulsion/engine[0]/thrust-lbs</property><property>velocities/v-down-fps</property><property>position/h-agl-ft</property><property>attitude/pitch-rad</property><property>attitude/roll-rad</property><property>velocities/vt-fps</property><property>velocities/r-rad_sec</property><property>attitude/psi-deg</property></notify>
    </event>
    <event name="collective 0.3" persistent="false">
      <condition> simulation/sim-time-sec ge 43.0 </condition>
      <set name="fcs/collective-cmd-norm" value="0.3"/>
    </event>
    <event name="report 0.3" persistent="false">
      <condition> simulation/sim-time-sec ge 50.0 </condition>
      <notify><property>simulation/sim-time-sec</property><property>fcs/collective-cmd-norm</property><property>propulsion/engine[0]/collective-ctrl-rad</property><property>propulsion/engine[0]/thrust-lbs</property><property>velocities/v-down-fps</property><property>position/h-agl-ft</property><property>attitude/pitch-rad</property><property>attitude/roll-rad</property><property>velocities/vt-fps</property><property>velocities/r-rad_sec</property><property>attitude/psi-deg</property></notify>
    </event>
    <event name="final report" persistent="false">
      <condition> simulation/sim-time-sec ge 59.9 </condition>
      <notify><property>simulation/sim-time-sec</property><property>fcs/collective-cmd-norm</property><property>propulsion/engine[0]/collective-ctrl-rad</property><property>propulsion/engine[0]/thrust-lbs</property><property>velocities/v-down-fps</property><property>position/h-agl-ft</property><property>attitude/pitch-rad</property><property>attitude/roll-rad</property><property>velocities/vt-fps</property><property>velocities/r-rad_sec</property><property>attitude/psi-deg</property></notify>
    </event>

  </run>

</runscript>
